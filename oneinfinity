#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load .env if it exists
if [ -f "${SCRIPT_DIR}/.env" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        # Skip comments and empty lines
        [[ "$line" =~ ^#.*$ ]] && continue
        [[ -z "$line" ]] && continue
        # Export the variable
        export "$line"
    done < "${SCRIPT_DIR}/.env"
fi

exec "${SCRIPT_DIR}/venv/bin/python3" "${SCRIPT_DIR}/run.py" "$@"

