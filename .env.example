# ─────────────────────────────────────────────────────────────────────────────
# OneInfinity — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM providers ────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── GitHub token(s) for secret intelligence scanning ─────────────────────────
# Comma-separated for token rotation support
GITHUB_TOKEN=
GITHUB_TOKENS=

# ── Backend API ───────────────────────────────────────────────────────────────
# Stable API key for the OneInfinity web backend.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, an ephemeral key is generated at startup (not suitable for production).
ONEINFINITY_API_KEY=

# ── Ports (uncommon values to avoid conflicts with system services) ───────────
API_PORT=47291
FRONTEND_PORT=47292
PG_PORT=47293
REDIS_PORT=47294
NEO4J_HTTP_PORT=47295
NEO4J_BOLT_PORT=47296
MOBSF_PORT=47297

# Network binding
API_HOST=127.0.0.1
API_RELOAD=false

# ── Database ──────────────────────────────────────────────────────────────────
# POSTGRES_URL is required by DBManager to activate Postgres mode.
# Without it the backend falls back to SQLite regardless of DATABASE_URL.
DATABASE_URL=postgresql://oneinfinity:oneinfinity123@localhost:47293/oneinfinity
POSTGRES_URL=postgresql://oneinfinity:oneinfinity123@localhost:47293/oneinfinity
REDIS_URL=redis://:oneinfinity_redis@localhost:47294/0
# ── Optional proxy ────────────────────────────────────────────────────────────
PROXY_URL=

# ═══════════════════════════════════════════════════════════════
# Distributed Docker Compose settings (docker-compose.distributed.yml)
# ═══════════════════════════════════════════════════════════════

# Data & plugin directories (bind-mounted)
DATA_DIR=./data
PLUGIN_DIR=./plugins/community

# Container image tag (use 'latest-ai' for AI worker profile)
IMAGE_TAG=latest

# Public ports
HTTP_PORT=80
REDIS_PORT=6380
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
REDIS_UI_PORT=8081

# Worker concurrency (tasks per worker container instance)
RECON_CONCURRENCY=3
VULN_CONCURRENCY=2
EXPLOIT_CONCURRENCY=2
AI_CONCURRENCY=1

# Worker resource limits
WORKER_CPU_LIMIT=2.0
WORKER_MEM_LIMIT=2g

# Auto-update settings
UPDATE_SCHEDULE=0 4 * * *
NUCLEI_UPDATE=1
DOCKER_UPDATE=0
SLACK_WEBHOOK=

# GHCR credentials for Watchtower image pulls
GHCR_USER=
GHCR_TOKEN=

# Monitoring
# Grafana admin password — REQUIRED, do not leave empty in production
GRAFANA_PASSWORD=
PROMETHEUS_RETENTION=30d

LOG_LEVEL=INFO
