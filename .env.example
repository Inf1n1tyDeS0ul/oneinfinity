# ─────────────────────────────────────────────────────────────────────────────
# OneInfinity — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM providers ────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── GitHub token(s) for secret intelligence scanning ─────────────────────────
# Comma-separated for token rotation support
GITHUB_TOKEN=
GITHUB_TOKENS=

# ── Backend API ───────────────────────────────────────────────────────────────
# Stable API key for the OneInfinity web backend.
# If unset, an ephemeral key is generated at startup (not suitable for production).
ONEINFINITY_API_KEY=

# Network binding (defaults: 127.0.0.1:8000)
API_HOST=127.0.0.1
API_PORT=8000
# Set to "true" only in local development
API_RELOAD=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Optional proxy ────────────────────────────────────────────────────────────
PROXY_URL=
