# ==============================================================
# OneInfinity — .dockerignore
# Keeps the build context lean: excludes test data, IDE files,
# the bundled venv, and anything that doesn't affect the image.
# ==============================================================

# ── Python artefacts ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
web/backend/.venv/
# (This one is huge — ~300 MB — never include in build context)

# ── Distribution / packaging ──────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# ── Testing ───────────────────────────────────────────────────
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── Local scan output (can be gigabytes) ──────────────────────
output/
*.db
*.sqlite
*.sqlite3
# Only exclude top-level raw data; the path_manager writes to
# ONEINFINITY_HOME which is /data inside the container anyway.
.oneinfinity/

# ── Documentation (not needed at runtime) ─────────────────────
docs/
examples/
*.md
!README.md

# ── IDE and editor files ──────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Git ───────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/

# ── CI / DevOps ───────────────────────────────────────────────
.travis.yml
.circleci/
Jenkinsfile
docker-compose*.yml

# ── Secrets / environment files ───────────────────────────────
.env
.env.*
*.pem
*.key
*.crt
*.p12
secrets/
credentials/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── AI tool directories (no runtime value) ───────────────────
.claude/
.gemini/
.codex/
.opencode/
.cursor/
.superpowers/

# ── Frontend build artifacts ──────────────────────────────────
web/frontend/node_modules/
web/frontend/.vite/
web/frontend/dist/
*.map

# ── Large or unnecessary repo data ───────────────────────────
# Nuclei templates are downloaded at runtime via entrypoint
nuclei-templates/
wordlists/
